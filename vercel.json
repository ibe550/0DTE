{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/callback",
      "dest": "main.py"
    },
    {
      "src": "/api/market-data",
      "dest": "main.py"
    },
    {
      "src": "/api/refresh-token",
      "dest": "main.py"
    },
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "crons": [
    {
      "path": "/api/refresh-token",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/check-shock",
      "schedule": "*/5 13-21 * * 1-5"
    }
  ]
}
