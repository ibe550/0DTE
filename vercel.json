{
  "routes": [
    {
      "src": "/api/callback",
      "dest": "main.py"
    },
    {
      "src": "/api/market-data",
      "dest": "main.py"
    },
    {
      "src": "/api/refresh-token",
      "dest": "main.py"
    },
    {
      "src": "/(.*)",
      "destination": "main.py"
    }
  ],
  "crons": [
    {
      "path": "/api/refresh-token",
      "schedule": "0 8 * * *"
    }
  ]
}
